# 版本控制
.git
.gitignore

# Python 虚拟环境与缓存
.venv
__pycache__
*.pyc
*.pyo
.mypy_cache
.ruff_cache
.pytest_cache

# 前端构建产物与依赖（容器内重新构建）
frontend/node_modules
frontend/dist

# 运行时数据（通过 volume 挂载，不进镜像）
reports/
data/
*.db

# 测试与文档
tests/
docs/
.trae/

# Docker 自身文件
docker/
Dockerfile
docker-compose.yml
.dockerignore

# 本地环境配置（容器运行时通过 env_file 注入）
.env
