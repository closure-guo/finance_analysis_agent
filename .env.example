# ===== LLM 配置 =====

# LLM API Key（必填）— 也可用 DEEPSEEK_API_KEY 作为回退
LLM_API_KEY=your-api-key-here

# 深度模式模型名，litellm 格式（默认: deepseek/deepseek-v4-pro）
# 示例: openai/gpt-4o, anthropic/claude-sonnet-4-20250514
# LLM_MODEL=deepseek/deepseek-v4-pro

# 快速/追问模式模型名（默认: deepseek/deepseek-chat）
# LLM_QUICK_MODEL=deepseek/deepseek-chat

# API 端点（默认: https://api.deepseek.com）
# LLM_BASE_URL=https://api.deepseek.com

# 思考模式 enabled / disabled（默认: enabled）
# LLM_THINKING=enabled

# 思考强度 low / high / max（默认: max）
# LLM_REASONING_EFFORT=max

# ===== 输出与数据 =====

# 报告输出目录（默认: reports）
# REPORTS_DIR=reports

# 事件数据源 builtin / web / auto（默认: auto）
# EVENT_SOURCE=auto

# ===== Web 搜索（Tavily）=====
# 快速模式 web_search 工具需要，未配置则实时搜索不可用
# 获取: https://tavily.com
# TAVILY_API_KEY=tvly-xxxxxxxxxxxx

# ===== Langfuse 可观测性（可选）=====
# 配置后所有 LLM 调用将自动上报到 Langfuse，未配置则跳过
# LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# LANGFUSE_SECRET_KEY=sk-lf-xxx
# LANGFUSE_HOST=https://cloud.langfuse.com
