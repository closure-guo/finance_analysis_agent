{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Finance Analysis Agent 完整链路（LangGraph）",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "output": "docs/assets/pipeline-workflow.html"
  },
  "lanes": [
    {
      "id": "data",
      "label": "数据准备"
    },
    {
      "id": "agents",
      "label": "Layer I–II 分析与辩论"
    },
    {
      "id": "chain",
      "label": "Layer III–IV 决策与风控"
    },
    {
      "id": "approval",
      "label": "Layer V 审批与产出"
    }
  ],
  "phases": [
    {
      "id": "prep",
      "label": "数据准备",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "analysis",
      "label": "分析 · 门禁 · 辩论",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "final",
      "label": "决策 · 风控 · 审批",
      "fromCol": 4,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "fetch",
    "validate",
    "metrics",
    "analysts",
    "citation",
    "debate",
    "rm",
    "trader",
    "price",
    "risk_debate",
    "risk_judge",
    "fm",
    "report"
  ],
  "nodes": [
    {
      "id": "fetch",
      "lane": "data",
      "col": 0,
      "type": "backend",
      "label": "fetch_data",
      "sublabel": "缓存检查·抓取数据",
      "width": 150
    },
    {
      "id": "validate",
      "lane": "data",
      "col": 1,
      "type": "security",
      "label": "validate_financials",
      "tag": "fail-fast",
      "width": 156
    },
    {
      "id": "metrics",
      "lane": "data",
      "col": 1,
      "type": "backend",
      "label": "compute_metrics",
      "sublabel": "指标=校验真源",
      "width": 156,
      "yOffset": 120
    },
    {
      "id": "end",
      "lane": "data",
      "col": 1,
      "type": "security",
      "label": "END",
      "sublabel": "数据不可用终止",
      "width": 130,
      "yOffset": 250
    },
    {
      "id": "analysts",
      "lane": "agents",
      "col": 2,
      "type": "backend",
      "label": "四分析师并行",
      "sublabel": "技术/宏观/基本面/情绪",
      "width": 156
    },
    {
      "id": "citation",
      "lane": "agents",
      "col": 2,
      "type": "security",
      "label": "verify_citations",
      "tag": "retry默认停用",
      "width": 156,
      "yOffset": 120
    },
    {
      "id": "debate",
      "lane": "agents",
      "col": 3,
      "type": "backend",
      "label": "多空辩论 ×2轮",
      "sublabel": "Bull/Bear 并行",
      "width": 150
    },
    {
      "id": "rm",
      "lane": "chain",
      "col": 3,
      "type": "backend",
      "label": "research_manager",
      "sublabel": "评级+置信度",
      "width": 150
    },
    {
      "id": "trader",
      "lane": "chain",
      "col": 4,
      "type": "backend",
      "label": "trader",
      "sublabel": "方案+evidence_refs",
      "width": 156
    },
    {
      "id": "price",
      "lane": "chain",
      "col": 4,
      "type": "security",
      "label": "validate_trade_prices",
      "sublabel": "价位校验",
      "width": 156,
      "yOffset": 120
    },
    {
      "id": "risk_debate",
      "lane": "chain",
      "col": 5,
      "type": "backend",
      "label": "风险辩论 ×2轮",
      "sublabel": "激进/保守/中性并行",
      "width": 156
    },
    {
      "id": "risk_judge",
      "lane": "chain",
      "col": 5,
      "type": "backend",
      "label": "risk_judge",
      "sublabel": "最终裁决",
      "width": 150,
      "yOffset": 120
    },
    {
      "id": "fm",
      "lane": "approval",
      "col": 5,
      "type": "security",
      "label": "fund_manager",
      "sublabel": "approve/reject/return",
      "width": 160,
      "tag": "退回上限1次"
    },
    {
      "id": "report",
      "lane": "approval",
      "col": 5,
      "type": "frontend",
      "label": "generate_report",
      "sublabel": "渲染并导出报告",
      "width": 156,
      "yOffset": 140
    }
  ],
  "edges": [
    {
      "id": "fetch-validate",
      "from": "fetch",
      "to": "validate"
    },
    {
      "id": "validate-metrics",
      "from": "validate",
      "to": "metrics"
    },
    {
      "id": "validate-end",
      "from": "validate",
      "to": "end",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "metrics-analysts",
      "from": "metrics",
      "to": "analysts"
    },
    {
      "id": "analysts-citation",
      "from": "analysts",
      "to": "citation"
    },
    {
      "id": "citation-analysts",
      "from": "citation",
      "to": "analysts",
      "variant": "dashed",
      "role": "return"
    },
    {
      "id": "citation-debate",
      "from": "citation",
      "to": "debate"
    },
    {
      "id": "debate-rm",
      "from": "debate",
      "to": "rm"
    },
    {
      "id": "rm-trader",
      "from": "rm",
      "to": "trader"
    },
    {
      "id": "trader-price",
      "from": "trader",
      "to": "price"
    },
    {
      "id": "price-trader",
      "from": "price",
      "to": "trader",
      "variant": "dashed",
      "role": "return"
    },
    {
      "id": "price-risk",
      "from": "price",
      "to": "risk_debate"
    },
    {
      "id": "risk-riskjudge",
      "from": "risk_debate",
      "to": "risk_judge"
    },
    {
      "id": "riskjudge-fm",
      "from": "risk_judge",
      "to": "fm"
    },
    {
      "id": "fm-report",
      "from": "fm",
      "to": "report"
    },
    {
      "id": "fm-trader",
      "from": "fm",
      "to": "trader",
      "variant": "dashed",
      "role": "return"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "三个反馈环",
      "items": [
        "validate_trade_prices 价位不合理 → 打回 trader 重出方案",
        "fund_manager return → 退回 trader（上限 1 次，第二次直接出报告）",
        "verify_citations retry → 分析师重写（incident 026 后默认停用）"
      ]
    },
    {
      "dot": "rose",
      "title": "图外语义",
      "items": [
        "四分析师与两场辩论均为并行扇出，同轮互不可见",
        "LLM judge 离线对 trace 评估，不在图内",
        "StreamRegistry 为进程内内存 → 后端仅单 uvicorn worker"
      ]
    }
  ]
}