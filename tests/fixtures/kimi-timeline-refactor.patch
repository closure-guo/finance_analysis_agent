 .expand-content.open { max-height: 2000px; opacity: 1; }
 
+/* ── Kimi 风格思考时间轴 ── */
+/* 统一白色圆角容器：包住整条 agentTimeline 的思考/搜索/工具调用横幅 */
+.timeline-container {
+  position: relative;
+  background: #FFFFFF;
+  border: 1px solid var(--border-neutral-l1);
+  border-radius: 12px;
+  padding: 6px 12px;
+  margin-bottom: 8px;
+}
+/* 贯穿竖线：absolute 定位在容器左 padding 内（left=19px，节点图标 16px 宽，图标中心 20px ≈ 竖线中线 19.5px），
+   top/bottom 落在首尾 item 的标题行高度附近，形成"一条竖线串联所有节点"的视觉 */
+.timeline-line {
+  position: absolute;
+  left: 19px;
+  top: 21px;
+  bottom: 21px;
+  width: 1px;
+  background: var(--border-neutral-l2);
+}
+/* 每个时间轴条目：节点图标 + 横幅内容，占一行 */
+.timeline-item {
+  position: relative;
+  display: flex;
+  align-items: flex-start;
+  gap: 6px;
+  padding: 3px 0;
+}
+/* 节点图标：白色圆底（盖住竖线形成节点），固定在竖线位置 */
+.timeline-node {
+  flex-shrink: 0;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: #FFFFFF;
+  border-radius: 50%;
+  position: relative;
+  z-index: 1;
+  margin-top: 9px; /* 与横幅标题行基线对齐（标题行高约 30px，图标 16px 居中） */
+}
+
 /* Chips */
 .chip { transition: all 0.2s ease; cursor: pointer; }
 .chip:hover { background: var(--bg-brand-popup); border-color: var(--bg-brand); transform: translateY(-1px); }
